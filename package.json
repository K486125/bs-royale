{
  "name": "bs-royale",
  "version": "1.0.4",
  "description": "BS Royale - 실시간 1대1 대전 게임",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "dev2": "electron . --dual",
    "dist": "electron-builder --win",
    "prerelease": "node scripts/check-share.js",
    "release": "node scripts/release.js",
    "sync-share": "node scripts/sync-share.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "overrides": {
    "@noble/hashes": "1.8.0"
  },
  "build": {
    "appId": "com.zer0yale.bsroyale",
    "productName": "BS Royale",
    "files": [
      "**/*",
      "!node_modules/electron-builder/**",
      "!note.txt",
      "!docs/**",
      "!scripts/**",
      "!build/**",
      "!database.rules.json",
      "!netlify.toml",
      "!Smile_Pin.png",
      "!.claude/**"
    ],
    "win": {
      "target": "nsis",
      "protocols": {
        "name": "BS Royale Protocol",
        "schemes": [
          "bsbattle"
        ]
      }
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": {
      "provider": "github",
      "owner": "K486125",
      "repo": "bs-royale",
      "releaseType": "release"
    }
  }
}
