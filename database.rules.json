{
  "rules": {
    "presence": {
      ".read": "auth != null",

      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 12" },
        "avatar": { ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z]+_[0-9]{3}_Icon[.]png$/)" },
        "connectedAt": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    },

    "chats": {
      "$roomId": {
        ".read": "auth != null && (root.child('rooms').child($roomId).child('hostUid').val() === auth.uid || root.child('rooms').child($roomId).child('guestUid').val() === auth.uid)",
        ".write": "auth != null && (root.child('rooms').child($roomId).child('hostUid').val() === auth.uid || root.child('rooms').child($roomId).child('guestUid').val() === auth.uid || (!root.child('rooms').child($roomId).exists() && !newData.exists()))",

        "$msgId": {
          "uid": { ".validate": "newData.isString() && (newData.val() === auth.uid || newData.parent().child('type').exists())" },
          "type": { ".validate": "newData.isString() && newData.val().matches(/^(join|leave|match)$/)" },
          "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 12" },
          "text": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 200 && newData.parent().child('uid').val() === auth.uid" },
          "$other": { ".validate": false }
        }
      }
    },

    "rooms": {
      ".read": "auth != null",

      "$roomId": {
        ".write": "auth != null && ((!data.exists() && newData.child('hostUid').val() === auth.uid) || (data.exists() && (data.child('hostUid').val() === auth.uid || data.child('guestUid').val() === auth.uid)) || (data.exists() && !newData.exists() && data.child('hostOnline').val() !== true && (!data.child('guestUid').exists() || data.child('guestOnline').val() !== true) && (!data.child('lastSeen').exists() || data.child('lastSeen').val() < now - 60000)))",

        "hostUid": {
          ".validate": "newData.isString() && (newData.val() === auth.uid || newData.val() === root.child('rooms').child($roomId).child('hostUid').val() || newData.val() === root.child('rooms').child($roomId).child('guestUid').val())"
        },
        "guestUid": {
          ".validate": "newData.isString() && (newData.val() === auth.uid || newData.val() === root.child('rooms').child($roomId).child('guestUid').val() || root.child('rooms').child($roomId).child('requests').child(newData.val()).exists())"
        },

        "hostName": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 12" },
        "guestName": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 12" },
        "hostAvatar": { ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z]+_[0-9]{3}_Icon[.]png$/)" },
        "guestAvatar": { ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z]+_[0-9]{3}_Icon[.]png$/)" },
        "hostUnits": {
          "$slot": { ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z]+_[0-9]{3}_Icon[.]png$/) && $slot.matches(/^[0-2]$/)" }
        },
        "guestUnits": {
          "$slot": { ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z]+_[0-9]{3}_Icon[.]png$/) && $slot.matches(/^[0-2]$/)" }
        },
        "hostReady": { ".validate": "newData.isBoolean()" },
        "guestReady": { ".validate": "newData.isBoolean()" },
        "hostOnline": { ".validate": "newData.isBoolean()" },
        "guestOnline": { ".validate": "newData.isBoolean()" },
        "playerCount": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 2" },
        "status": { ".validate": "newData.isString() && newData.val().matches(/^(waiting|full)$/)" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "lastSeen": { ".validate": "newData.isNumber()" },

        "hostChatSince": { ".validate": "newData.isString() && newData.val().length <= 32" },
        "guestChatSince": { ".validate": "newData.isString() && newData.val().length <= 32" },
        "matchEndPending": { ".validate": "newData.isBoolean()" },
        "hostNavigating": { ".validate": "newData.isBoolean()" },
        "guestNavigating": { ".validate": "newData.isBoolean()" },
        "hostTyping": { ".validate": "newData.isBoolean()" },
        "guestTyping": { ".validate": "newData.isBoolean()" },

        "requests": {
          "$reqUid": {
            ".write": "auth != null && auth.uid === $reqUid",
            "guestName": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 12" },
            "guestAvatar": { ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z]+_[0-9]{3}_Icon[.]png$/)" },
            "guestUnits": {
              "$slot": { ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z]+_[0-9]{3}_Icon[.]png$/) && $slot.matches(/^[0-2]$/)" }
            },
            "createdAt": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },

        "battle": {
          "phase": { ".validate": "newData.isString() && newData.val().matches(/^(loading|placing|countdown|playing|finished)$/)" },
          "createdAt": { ".validate": "newData.isNumber()" },
          "placingStartedAt": { ".validate": "newData.isNumber()" },
          "countdownStartedAt": { ".validate": "newData.isNumber()" },
          "finishedAt": { ".validate": "newData.isNumber()" },

          "turn": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 10" },
          "active": { ".validate": "newData.isString() && newData.val().matches(/^(host|guest)$/)" },
          "movesLeft": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3" },
          "actedAt": { ".validate": "newData.isNumber()" },
          "endReason": { ".validate": "newData.isString() && newData.val().matches(/^(timeout|turns)$/)" },

          "hostHp": {
            "$slot": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000 && $slot.matches(/^[0-2]$/)" }
          },
          "guestHp": {
            "$slot": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000 && $slot.matches(/^[0-2]$/)" }
          },

          "hostAttacked": {
            "$slot": { ".validate": "newData.isBoolean() && $slot.matches(/^[0-2]$/) && root.child('rooms').child($roomId).child('hostUid').val() === auth.uid" }
          },
          "guestAttacked": {
            "$slot": { ".validate": "newData.isBoolean() && $slot.matches(/^[0-2]$/) && root.child('rooms').child($roomId).child('guestUid').val() === auth.uid" }
          },

          "hostSelected": { ".validate": "newData.isString() && newData.val().matches(/^[0-6]_[0-6]$/) && root.child('rooms').child($roomId).child('hostUid').val() === auth.uid" },
          "guestSelected": { ".validate": "newData.isString() && newData.val().matches(/^[0-6]_[0-6]$/) && root.child('rooms').child($roomId).child('guestUid').val() === auth.uid" },

          "hostDone": { ".validate": "newData.isBoolean() && root.child('rooms').child($roomId).child('hostUid').val() === auth.uid" },
          "guestDone": { ".validate": "newData.isBoolean() && root.child('rooms').child($roomId).child('guestUid').val() === auth.uid" },

          "hostPlacements": {
            "$tile": {
              ".validate": "root.child('rooms').child($roomId).child('hostUid').val() === auth.uid && $tile.matches(/^[0-6]_[0-6]$/) && (root.child('rooms').child($roomId).child('battle').child('phase').val() !== 'placing' || $tile.matches(/^[4-6]_[0-6]$/))",
              "slot": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 2" },
              "file": { ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z]+_[0-9]{3}_Icon[.]png$/)" },
              "$other": { ".validate": false }
            }
          },
          "guestPlacements": {
            "$tile": {
              ".validate": "root.child('rooms').child($roomId).child('guestUid').val() === auth.uid && $tile.matches(/^[0-6]_[0-6]$/) && (root.child('rooms').child($roomId).child('battle').child('phase').val() !== 'placing' || $tile.matches(/^[0-2]_[0-6]$/))",
              "slot": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 2" },
              "file": { ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z]+_[0-9]{3}_Icon[.]png$/)" },
              "$other": { ".validate": false }
            }
          },

          "$other": { ".validate": false }
        },

        "$other": { ".validate": false }
      }
    }
  }
}
